DJANGO_SECRET_KEY=change-me-for-local-development
JWT_SIGNING_KEY=generate-a-separate-random-signing-key
MERCHANT_PASSWORD_RECOVERY_OTP_PEPPER=generate-a-separate-random-recovery-secret
MERCHANT_PASSWORD_RECOVERY_OTP_SENDER=
SUPER_ADMIN_RECOVERY_SECRET_PEPPER=generate-a-separate-random-recovery-secret
SUPER_ADMIN_RECOVERY_EMAIL_SENDER=
SUPER_ADMIN_RECOVERY_SMS_SENDER=
SUPER_ADMIN_RECOVERY_CODE_TTL_SECONDS=300
SUPER_ADMIN_RECOVERY_REQUEST_LIMIT=3
SUPER_ADMIN_RECOVERY_REQUEST_WINDOW_SECONDS=3600
SUPER_ADMIN_RECOVERY_ATTEMPT_LIMIT=5
SUPER_ADMIN_RECOVERY_REAUTH_ATTEMPT_LIMIT=5
SUPER_ADMIN_RECOVERY_IP_REQUEST_LIMIT=10
SUPER_ADMIN_RECOVERY_IP_WINDOW_SECONDS=900
# Debug defaults to OFF. Set True only on your own machine.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Number of reverse proxies in front of the API (Vercel = 1; set automatically there).
# NUM_PROXIES=0
# Serve uploaded images from Django when DEBUG is off (use object storage in production).
# SERVE_MEDIA=False
DJANGO_PORT=8000

POSTGRES_DB=grocery_platform
POSTGRES_USER=grocery_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# For Neon, use the pooled host (the hostname containing "-pooler") so connections are
# multiplexed by PgBouncer, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Keep the database in the same region as the API; every query is a network round trip.
DATABASE_URL=
# Seconds to keep DB connections open between requests (0 = reconnect every request).
# Defaults to 60 (0 on Vercel). Persistent connections need a multi-request server such as
# gunicorn (Docker uses it); Django's threaded runserver opens one connection per request
# thread. Without Docker on Windows (no gunicorn), run: python manage.py runserver --nothreading
# DB_CONN_MAX_AGE=60

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
